<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Backend base URL: production on Render. For a local backend use http://localhost:8001/api/v1
	     (the Simulator can reach the Mac's localhost; on a device use the Mac's LAN IP). -->
	<key>API_BASE_URL</key>
	<string>https://housemate-api-rjhl.onrender.com/api/v1</string>
	<!-- The website: invite links, privacy policy and support pages. Switch to the custom domain once it's live. -->
	<key>WEB_BASE_URL</key>
	<string>https://housemate-web.onrender.com</string>
	<!-- Only HTTPS (no custom encryption): App Store Connect stops asking about export compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Allow plain HTTP to localhost / LAN for local development only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>

# PostgreSQL (used by docker-compose)
POSTGRES_USER=roommate
POSTGRES_PASSWORD=roommate
POSTGRES_DB=roommate
POSTGRES_PORT=5434

# Backend
DATABASE_URL=postgresql+psycopg://roommate:roommate@localhost:5434/roommate
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional: "Continue with Google / Facebook" (docs/SOCIAL_LOGIN_SETUP.md). Apple needs no keys.
# GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=1234-def.apps.googleusercontent.com
# FACEBOOK_APP_ID=1234567890
# FACEBOOK_APP_SECRET=...

# Web
VITE_API_BASE_URL=http://localhost:8001/api/v1
